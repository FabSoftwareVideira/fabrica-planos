# Proxy interno do validador: login com gov.br (feito pelo app) ou com a conta Google institucional
# (oauth2-proxy) e repasse ao app.
# Fica atrás do Traefik do Dokploy, que recebe o domínio e cuida do HTTPS; aqui é HTTP puro na porta 80,
# sem porta publicada no host (ver docker-compose.yml).
{
	# Certificados são do Traefik
	auto_https off
	servers {
		# O Traefik (rede interna do Docker) informa o esquema e o host originais em X-Forwarded-*:
		# o oauth2-proxy precisa deles para montar o endereço https de retorno do Google.
		trusted_proxies static private_ranges
	}
}

:80 {
	# Compressão: o CSS do Design System gov.br cai de ~570 KB para ~70 KB
	encode zstd gzip

	header {
		# O site só é acessado por HTTPS (Traefik): o navegador passa a recusar HTTP por um ano
		Strict-Transport-Security "max-age=31536000"
		# Não anuncia o software do servidor (Caddy, gunicorn)
		-Server
	}

	# Telas de login, retorno do Google e saída
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	# Login com gov.br (ida, retorno em /auth/govbr/callback e saída) e a escolha do login: públicos, no app
	@login path /auth/* /entrar
	handle @login {
		request_header -X-Usuario-Email
		request_header -X-Usuario-Token
		reverse_proxy fabrica-planos-web-interno:8000
	}

	# CSS, JS, fontes e ícones: públicos (a página inicial usa o Design System gov.br) e sem nada sigiloso
	handle /static/* {
		request_header -X-Usuario-Email
		request_header -X-Usuario-Token
		reverse_proxy fabrica-planos-web-interno:8000
	}

	# Verificação de saúde, pública: healthcheck do container caddy e monitoramento externo (Uptime Kuma)
	handle /health {
		request_header -X-Usuario-Email
		request_header -X-Usuario-Token
		reverse_proxy fabrica-planos-web-interno:8000
	}

	# Página inicial, pública: apresenta o projeto e tem o botão de login
	handle / {
		request_header -X-Usuario-Email
		request_header -X-Usuario-Token
		reverse_proxy fabrica-planos-web-interno:8000
	}

	handle {
		# route mantém a ordem: os cabeçalhos vindos do navegador são apagados antes de a verificação
		# preencher o e-mail de quem fez login e o token com o nome; o app confia neles para saber quem é e
		# se é administrador. A verificação (/auth/verificar, no app) aceita a sessão gov.br do app ou a do
		# Google, que ela confere no oauth2-proxy.
		route {
			request_header -X-Usuario-Email
			request_header -X-Usuario-Token
			forward_auth fabrica-planos-web-interno:8000 {
				uri /auth/verificar
				copy_headers X-Usuario-Email X-Usuario-Token
				# Sem sessão, só a navegação (abrir a página) vai para o login. Requisições da página
				# (fetch de /status, /planos) recebem 401: se fossem redirecionadas, cada uma iniciaria
				# outro login e trocaria o cookie CSRF do que está em andamento ("CSRF token" na volta).
				@sem_login status 401
				handle_response @sem_login {
					@navegacao header Sec-Fetch-Mode navigate
					redir @navegacao /entrar?rd={uri}
					respond "Login necessário" 401
				}
			}
			reverse_proxy fabrica-planos-web-interno:8000
		}
	}
}
