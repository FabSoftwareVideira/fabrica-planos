# Copie para .env e ajuste para o servidor

# Porta HTTP da aplicação (dashboard, /validar, /pdf)
APP_PORT=8080

# Ollama sobe junto no docker compose e é acessado pelo nome do serviço (ollama)
OLLAMA_URL=http://ollama:11434

# Porta do Ollama no host (para usar a API fora do compose). OLLAMA_BIND=0.0.0.0
# libera o acesso pela rede; o padrão 127.0.0.1 aceita só a própria máquina.
OLLAMA_PORT=11434
OLLAMA_BIND=127.0.0.1

# Pasta com os PDFs dos planos (relativa a esta pasta: a pasta planos/ do projeto fabrica-planos)
PLANOS_HOST_DIR=../planos

# Modelo e contexto usados na validação
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# Hora (0-23) da validação diária automática
AGENDAMENTO_HORA=5

TZ=America/Sao_Paulo
