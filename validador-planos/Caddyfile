# Proxy na frente do validador: HTTPS (Let's Encrypt) e login com a conta Google institucional.
# Com APP_HOST vazio o endereço vira ":APP_PORT" e o Caddy serve HTTP puro, sem certificado
# (uso local). Com um nome (ex.: planos.200-135-55-29.sslip.io) emite o certificado pela porta 80.
{$APP_HOST}:{$APP_PORT} {
	# Compressão: o CSS do Design System gov.br cai de ~570 KB para ~70 KB
	encode zstd gzip

	# Telas de login, retorno do Google e saída
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	# CSS, JS, fontes e ícones: públicos (a página inicial usa o Design System gov.br) e sem nada sigiloso
	handle /static/* {
		request_header -X-Usuario-Email
		request_header -X-Usuario-Token
		reverse_proxy app:8000
	}

	# Página inicial, pública: apresenta o projeto e tem o botão de login
	handle / {
		request_header -X-Usuario-Email
		request_header -X-Usuario-Token
		reverse_proxy app:8000
	}

	handle {
		# route mantém a ordem: os cabeçalhos vindos do navegador são apagados antes de o oauth2-proxy
		# preencher o e-mail de quem fez login e o ID token do Google (de onde o app lê o nome);
		# o app confia neles para saber quem é e se é administrador.
		route {
			request_header -X-Usuario-Email
			request_header -X-Usuario-Token
			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				copy_headers X-Auth-Request-Email>X-Usuario-Email Authorization>X-Usuario-Token
				# Sem sessão, só a navegação (abrir a página) vai para o login. Requisições da página
				# (fetch de /status, /planos) recebem 401: se fossem redirecionadas, cada uma iniciaria
				# outro login e trocaria o cookie CSRF do que está em andamento ("CSRF token" na volta).
				@sem_login status 401
				handle_response @sem_login {
					@navegacao header Sec-Fetch-Mode navigate
					redir @navegacao /oauth2/start?rd={uri}
					respond "Login necessário" 401
				}
			}
			reverse_proxy app:8000
		}
	}
}
