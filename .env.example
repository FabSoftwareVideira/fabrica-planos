# Copie para .env e ajuste para o servidor

# Porta da aplicação (dashboard, /validar, /pdf), servida pelo Caddy
APP_PORT=443

# Nome pelo qual a aplicação é acessada; com ele o Caddy emite o certificado HTTPS
# (a porta 80 precisa estar liberada de fora). sslip.io dispensa registrar domínio.
# Vazio: HTTP puro em APP_PORT, sem certificado (uso local).
APP_HOST=planos.200-135-55-29.sslip.io

# Login com a conta Google institucional (oauth2-proxy). Crie o cliente OAuth em
# console.cloud.google.com (APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web")
# com o URI de redirecionamento https://APP_HOST/oauth2/callback (com :APP_PORT se não for 443).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave do cookie de sessão, 32 caracteres. Gere com: openssl rand -hex 16
COOKIE_SECRET=
# Domínio de e-mail aceito no login (alunos usam @estudantes.ifc.edu.br e ficam de fora)
EMAIL_DOMINIO=ifc.edu.br

# Quem pode enviar/excluir PDFs e disparar validações, separados por vírgula.
# Os demais servidores que entram só consultam resultados, relatórios e PDFs.
ADMIN_EMAILS=seu.nome@ifc.edu.br

# Ollama sobe junto no docker compose e é acessado pelo nome do serviço (ollama)
OLLAMA_URL=http://ollama:11434

# Porta do Ollama no host (para usar a API fora do compose). OLLAMA_BIND=0.0.0.0
# libera o acesso pela rede; o padrão 127.0.0.1 aceita só a própria máquina.
OLLAMA_PORT=11434
OLLAMA_BIND=127.0.0.1

# Pasta com os PDFs dos planos (relativa a esta pasta: planos/, fora do git)
PLANOS_HOST_DIR=./planos

# Modelo e contexto usados na validação
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# Hora (0-23) da validação diária automática
AGENDAMENTO_HORA=5

# Tamanho máximo (MB) de cada PDF enviado pelo dashboard
PDF_MAX_MB=10

TZ=America/Sao_Paulo
