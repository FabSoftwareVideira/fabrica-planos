# Variáveis de produção: cole na aba Environment do recurso no Dokploy e ajuste os valores.
# O domínio não fica aqui: é configurado na aba Domains do Dokploy (serviço caddy, porta 80, HTTPS).

# Login com a conta Google institucional (oauth2-proxy). Crie o cliente OAuth em
# console.cloud.google.com (APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web")
# com o URI de redirecionamento https://SEU_DOMINIO/oauth2/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave do cookie de sessão, 32 caracteres. Gere com: openssl rand -hex 16
COOKIE_SECRET=
# Domínio de e-mail aceito no login (alunos usam @estudantes.ifc.edu.br e ficam de fora)
EMAIL_DOMINIO=ifc.edu.br

# Login com gov.br (Login Único). Credenciais pedidas ao gov.br, com o endereço de retorno
# https://SEU_DOMINIO/auth/govbr/callback. Só entra quem tem na conta gov.br o e-mail @EMAIL_DOMINIO
# cadastrado e verificado. Sem GOVBR_CLIENT_ID, GOVBR_CLIENT_SECRET e SEGREDO_SESSAO, o botão não aparece.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
# producao (sso.acesso.gov.br) ou homologacao (sso.staging.acesso.gov.br, com credenciais de teste)
GOVBR_AMBIENTE=producao
GOVBR_REDIRECT_URI=https://planos.labia.ifc.edu.br/auth/govbr/callback
# Endereço de retorno depois de sair do gov.br, registrado no gov.br junto com o de cima
GOVBR_LOGOUT_URI=https://planos.labia.ifc.edu.br/auth/gov/logout
# Chave que assina o cookie da sessão gov.br. Gere com: openssl rand -hex 32
SEGREDO_SESSAO=
# 0 desliga o login com Google (fica só o gov.br)
LOGIN_GOOGLE=1

# Quem pode enviar/excluir PDFs e disparar validações, separados por vírgula.
# Os demais servidores que entram só consultam resultados, relatórios e PDFs.
ADMIN_EMAILS=seu.nome@ifc.edu.br

# Ollama do projeto Open WebUI, compartilhado pela rede Docker
OLLAMA_URL=http://ollama:11434

# Pastas fixas do servidor com os PDFs dos planos e os resultados (validação, usuários, revisões).
# Ficam fora do código porque o Dokploy clona o repositório de novo a cada deploy.
PLANOS_HOST_DIR=/srv/validador-planos/planos
RESULTADOS_HOST_DIR=/srv/validador-planos/resultados

# Modelo e contexto usados na validação
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# Hora (0-23) da validação diária automática
AGENDAMENTO_HORA=5

# Tamanho máximo (MB) de cada PDF enviado pelo dashboard
PDF_MAX_MB=10

TZ=America/Sao_Paulo

# Limites de hardware do app (opcionais; os padrões estão no docker-compose.yml).
# APP_MEMORIA=1500m
# APP_CPUS=1.5
